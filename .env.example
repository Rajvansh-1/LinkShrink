# ============================================================
# LinkShrink — Environment Variables for Vercel
# ============================================================
# Copy these values to your Vercel project:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
# ALL THREE are required for production to work correctly.
# ============================================================

# Your Turso database URL (from https://turso.tech dashboard)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io

# Your Turso auth token (from Turso dashboard → Generate Token)
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Your Vercel production URL — NO trailing slash!
# Example: https://linkshrink.vercel.app
# This is used to construct short URLs in API responses.
BASE_URL=https://your-project.vercel.app
